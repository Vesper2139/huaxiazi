{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huaxiazi:ai-blind-pairwise-answer-v1",
  "title": "Blind pairwise reviewer answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "votes", "adjudication"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "votes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_id", "choice"],
        "properties": {
          "reviewer_id": { "type": "string", "minLength": 1 },
          "choice": { "enum": ["left", "right", "tie"] }
        }
      }
    },
    "adjudication": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["adjudicator_id", "choice"],
      "properties": {
        "adjudicator_id": { "type": "string", "minLength": 1 },
        "choice": { "enum": ["left", "right", "tie"] }
      }
    }
  }
}
