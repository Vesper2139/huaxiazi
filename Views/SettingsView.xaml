                            </ListBox>
                            <Grid x:Name="ArchiveContextToolbar" Visibility="{Binding HasSelectedArchiveItem, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="已选择 1 条记录" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="FavoriteArchiveButton" Style="{StaticResource SettingsActionButton}" Content="{Binding FavoriteArchiveActionDisplay}" Command="{Binding ToggleFavoriteCommand}" /><Button x:Name="ArchiveItemButton" Style="{StaticResource SettingsActionButton}" Content="{Binding ArchiveItemActionDisplay}" Command="{Binding ToggleArchivedCommand}" Margin="5,0,0,0" /><Button Style="{StaticResource SettingsActionButton}" Content="删除" Command="{Binding SoftDeleteArchiveCommand}" Margin="5,0,0,0" /><Button Style="{StaticResource SettingsActionButton}" Content="恢复" Command="{Binding RestoreArchiveCommand}" Margin="5,0,0,0" /></StackPanel></Grid>
                            <Grid Visibility="{Binding HasSelectedArchiveItem, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBlock Text="原文" Style="{StaticResource LabelText}" /><TextBox x:Name="ArchiveOriginalPreview" Text="{Binding SelectedArchiveItem.OriginalText}" Style="{StaticResource GlassPlainTextBox}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="82" MaxHeight="140" Margin="0,5,0,0" /></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="优化稿" Style="{StaticResource LabelText}" /><TextBox x:Name="ArchiveResultPreview" Text="{Binding SelectedArchiveItem.FinalText}" Style="{StaticResource GlassPlainTextBox}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="82" MaxHeight="140" Margin="0,5,0,0" /></StackPanel></Grid>
                            <WrapPanel Margin="0,4,0,0">
                                <ComboBox x:Name="ExportFormatSelector" ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding SelectedExportFormat}" Style="{StaticResource GlassComboBox}" Width="110" Margin="0,0,6,0" />
                                <Button Style="{StaticResource SettingsActionButton}" Content="导出选中" Command="{Binding ExportArchiveCommand}" />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=数据维护}">
                            <TextBlock Text="数据维护" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="备份、迁移与清理本机数据。执行破坏性操作前，请先创建备份。" Style="{StaticResource SettingsSupportingText}" Margin="0,4,0,14" />
                            <Border Visibility="{Binding LegacyKnowledgeDetected, Converter={StaticResource BoolToVisibility}}" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BrandBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="12" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding LegacyKnowledgeStatus}" Foreground="{DynamicResource BodyTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"><Button Style="{StaticResource SettingsActionButton}" Content="导出旧数据" Click="ExportLegacyKnowledge_OnClick" /><Button Style="{StaticResource SettingsActionButton}" Foreground="{DynamicResource DangerBrush}" Content="永久删除" Click="DeleteLegacyKnowledge_OnClick" Margin="6,0,0,0" /></StackPanel></Grid></Border>
                            <TextBlock Text="备份与迁移" Style="{StaticResource SettingsGroupHeading}" Margin="0,0,0,8" />
                            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本地资料库" Foreground="{DynamicResource BodyTextBrush}" FontWeight="SemiBold" /><TextBlock Text="{Binding DataStatus}" Style="{StaticResource SettingsSupportingText}" Margin="0,3,0,0" /><TextBlock Text="{Binding DataDirectory}" Style="{StaticResource SettingsSupportingText}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel><Button Grid.Column="1" Style="{StaticResource SettingsActionButton}" Content="打开数据目录" Click="OpenDataFolderButton_OnClick" VerticalAlignment="Top" Margin="12,0,0,0" /></Grid>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button x:Name="BackupDataButton" Style="{StaticResource SettingsPrimaryButton}" Content="创建备份" Command="{Binding BackupDataCommand}" Margin="0,0,6,6" />
                                        <Button x:Name="ExportAllButton" Style="{StaticResource SettingsActionButton}" Content="导出全部" Command="{Binding ExportAllCommand}" Margin="0,0,6,6" />
                                <Button Style="{StaticResource SettingsActionButton}" Content="恢复备份" Click="RestoreBackupButton_OnClick" Margin="0,0,6,6" />
                                <Button Style="{StaticResource SettingsActionButton}" Content="导入记录" Click="ImportJsonButton_OnClick" Margin="0,0,6,6" ToolTip="支持 JSON、Markdown 和纯文本" />
                                        <Button Style="{StaticResource SettingsActionButton}" Content="迁移到新位置" Click="MigrateDataButton_OnClick" Margin="0,0,6,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="缓存" Style="{StaticResource SettingsGroupHeading}" />
                            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="14">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="清理临时缓存" Foreground="{DynamicResource BodyTextBrush}" FontWeight="SemiBold" /><TextBlock Text="释放临时文件，不影响历史记录、成稿与配置。" Style="{StaticResource SettingsSupportingText}" Margin="0,3,0,0" /></StackPanel><Button x:Name="ClearCacheButton" Grid.Column="1" Style="{StaticResource SettingsActionButton}" Content="清理" Command="{Binding ClearCacheCommand}" VerticalAlignment="Top" Margin="12,0,0,0" /></Grid>
                            </Border>
                            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="14" Margin="0,28,0,0">
                                <StackPanel>
                                    <TextBlock Text="危险操作" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="以下操作不可逆。永久清空会删除全部历史记录、草稿和回收站内容，请先创建备份。" Foreground="{DynamicResource DangerBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,10" />
                                    <Button Style="{StaticResource SettingsActionButton}" Foreground="{DynamicResource DangerBrush}" Content="永久清空历史与缓存…" Click="PermanentlyClearArchiveButton_OnClick" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=关于与更新}">
                            <TextBlock Text="关于与更新" Style="{StaticResource SectionTitle}" /><TextBlock Text="话匣子 · Windows 悬浮文字工具" Foreground="{DynamicResource BodyTextBrush}" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding CurrentVersion, StringFormat=当前版本 {0}}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="更新源地址（高级）" Style="{StaticResource LabelText}" Margin="0,14,0,0" />
                            <TextBox x:Name="UpdateCheckUrlTextBox" Text="{Binding UpdateCheckUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GlassPlainTextBox}" Margin="0,6,0,0" ToolTip="留空可关闭自动更新；仅接受 HTTPS 地址" />
                            <CheckBox x:Name="AutoCheckUpdatesCheckBox" Content="启动时自动检查更新" IsChecked="{Binding AutoCheckUpdates}" Foreground="{DynamicResource BodyTextBrush}" Margin="0,10,0,0" />
                            <TextBlock Text="系统健康检查" Style="{StaticResource LabelText}" Margin="0,16,0,0" />
                            <TextBlock x:Name="HealthSummaryText" Text="{Binding HealthSummary}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
                            <ItemsControl x:Name="HealthCheckList" ItemsSource="{Binding HealthItems}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="78" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Scope}" Foreground="{DynamicResource BrandBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource BodyTextBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="RunHealthCheckButton" Style="{StaticResource SettingsActionButton}" Content="重新检查本地与云端" Command="{Binding RunHealthCheckCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            <TextBlock x:Name="UpdateStatusText" Text="尚未检查更新" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckUpdateButton" Style="{StaticResource SettingsActionButton}" Content="检查更新" Click="CheckUpdateButton_OnClick" />
                                <Button x:Name="DownloadUpdateButton" Style="{StaticResource SettingsPrimaryButton}" Content="下载新版本" Click="DownloadUpdateButton_OnClick" Visibility="Collapsed" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</UserControl>
