<UserControl x:Class="Huaxiazi.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Huaxiazi.Views" FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <local:SectionVisibilityConverter x:Key="SectionVisibility" />
        <local:InverseBoolConverter x:Key="InverseBool" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:EnumDisplayNameConverter x:Key="EnumDisplayName" />
        <local:ProviderPlatformDisplayNameConverter x:Key="ProviderPlatformDisplayName" />
        <!-- 设置页采用一套克制的焦点环；键盘用户可定位，鼠标态不额外制造噪声。 -->
        <Style x:Key="SettingsFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-2" BorderBrush="{DynamicResource BrandBrush}" BorderThickness="1" CornerRadius="8" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsStepTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="SettingsSupportingText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="17" />
        </Style>
        <Style x:Key="CompactSettingsField" TargetType="TextBox" BasedOn="{StaticResource GlassPlainTextBox}">
            <Setter Property="Height" Value="{DynamicResource SkinControlHeight}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style x:Key="CompactSettingsComboBox" TargetType="ComboBox" BasedOn="{StaticResource GlassComboBox}">
            <Setter Property="Height" Value="{DynamicResource SkinControlHeight}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style x:Key="SettingsActionButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SettingsGroupHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
            <Setter Property="Margin" Value="0,24,0,8" />
        </Style>
        <Style x:Key="SettingsPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="{TemplateBinding Height}">
                            <Border Height="4" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="2" />
                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   VerticalAlignment="Center" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="0" Background="{TemplateBinding Foreground}" Height="4" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="18" Height="18" Background="{DynamicResource BrandBrush}" BorderBrush="{DynamicResource FocusBorderBrush}" BorderThickness="1" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="0" Background="Transparent" Height="4" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="Thumb" Property="IsMouseOver" Value="True"><Setter TargetName="Thumb" Property="Width" Value="20" /><Setter TargetName="Thumb" Property="Height" Value="20" /></Trigger>
                            <Trigger SourceName="Thumb" Property="IsDragging" Value="True"><Setter TargetName="Thumb" Property="Background" Value="{DynamicResource TextBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Thumb" Property="BorderBrush" Value="{DynamicResource BrandBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProviderProfileCardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border x:Name="Accent" Width="3" Background="Transparent" CornerRadius="2" Margin="0,2,0,2" />
                                <ContentPresenter Grid.Column="1" Margin="8,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource BrandBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProviderPresetItem" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="PresetCard" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PresetCard" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                <Setter TargetName="PresetCard" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PresetCard" Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                          Focusable="True" FocusVisualStyle="{StaticResource SettingsFocusVisual}"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Expander}}"
                                          HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="Chevron" Data="{StaticResource IconCollapse}"
                                                      Width="12" Height="12" Margin="0,0,6,0" Stretch="Uniform"
                                                      Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="180" /></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeChoiceItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Choice" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ButtonRadius}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                <Setter TargetName="Choice" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ArchiveListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" /><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BrandBrush}" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="15" Height="15" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource InputBorderBrush}" Background="{DynamicResource InputBrush}" VerticalAlignment="Center">
                            <Path x:Name="Mark" Style="{StaticResource CrispIconPath}" Data="{StaticResource IconResult}"
                                  Width="10" Height="10" Stroke="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource BrandBrush}" /><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrandBrush}" /><Setter TargetName="Mark" Property="Opacity" Value="1" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrandBrush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource GlassPanel}">
        <Grid Margin="18,12,18,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" MinHeight="38" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="设置" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="话匣子偏好" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource TitleBarButton}" Click="CloseButton_OnClick" ToolTip="关闭设置">
                    <Path Style="{StaticResource CrispIconPath}" Data="{StaticResource IconClose}" />
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Background="Transparent" BorderThickness="0"
                         Margin="0,18,18,18" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.Resources>
                        <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource OverlayScrollViewer}" />
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="MinHeight" Value="38" />
                            <Setter Property="Padding" Value="11,7" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Surface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Path x:Name="NavIcon" Style="{StaticResource CrispIconPath}" Data="{StaticResource IconModel}" />
                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding}" Value="表达与生成"><Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconPrompt}" /></DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="模型连接"><Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconModel}" /></DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="外观与窗口"><Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconPalette}" /></DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="快捷键"><Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconKeyboard}" /></DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="历史与留存"><Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconHistory}" /></DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="数据维护"><Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconArchive}" /></DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="关于与更新"><Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconBrandSpark}" /></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Column="1" Background="{DynamicResource GlassBorderBrush}" />

                <Border x:Name="SettingsContentFrame" Grid.Column="2" Margin="28,18,12,0"
                        Background="Transparent" BorderThickness="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border x:Name="SettingsValidationBanner" Grid.Row="0" Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibility}}"
                                Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,18,10">
                            <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                        </Border>
                    <ScrollViewer x:Name="SettingsPageScrollViewer" Grid.Row="1" Style="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                                  Margin="0" Padding="0,0,18,16">
                    <StackPanel HorizontalAlignment="Stretch" MaxWidth="780">
                        <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=模型连接}">
                            <TextBlock Text="模型连接" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="管理 AI 模型连接。首次使用时，请先添加服务并填写 API 密钥。" Style="{StaticResource SettingsSupportingText}" Margin="0,4,0,14" />

                            <!-- 配置资产与单项编辑严格分层：设置页初次进入只呈现配置管理。 -->
                            <Grid>
                                <local:ProviderProfileListView x:Name="ProviderProfileManager">
                                    <local:ProviderProfileListView.Style>
                                        <Style TargetType="local:ProviderProfileListView">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProviderViewMode}" Value="List">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </local:ProviderProfileListView.Style>
                                </local:ProviderProfileListView>
                                <local:ProviderProfileEditView x:Name="ProviderProfileEditor">
                                    <local:ProviderProfileEditView.Style>
                                        <Style TargetType="local:ProviderProfileEditView">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProviderViewMode}" Value="Edit">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </local:ProviderProfileEditView.Style>
                                </local:ProviderProfileEditView>
                            </Grid>
                        </StackPanel>

                        <local:ExpressionAbilitySettingsView x:Name="ExpressionAbilitySettingsPage" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=表达与生成}" />

                        <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=历史与留存}">
                            <TextBlock Text="历史与留存" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="决定哪些内容保存在本机、保留多久，并浏览已生成的记录。" Style="{StaticResource SettingsSupportingText}" Margin="0,4,0,14" />
                            <TextBlock Text="留存规则" Style="{StaticResource SettingsGroupHeading}" Margin="0,0,0,8" />
                            <CheckBox x:Name="HistoryEnabledCheckBox" Content="启用历史记录" IsChecked="{Binding HistoryEnabled}" Margin="0,14,0,4" />
                            <CheckBox Content="生成后自动归档版本" IsChecked="{Binding AutoArchive}" IsEnabled="{Binding CanConfigureHistoryStorage}" Margin="0,0,0,4" />
                            <CheckBox x:Name="IncognitoModeCheckBox" Content="无痕模式（不写草稿、不保存历史）" IsChecked="{Binding IncognitoMode}" Margin="0,0,0,8" />
                            <WrapPanel Margin="0,0,0,8">
                                <CheckBox x:Name="SaveOriginalTextCheckBox" Content="保存原文" IsChecked="{Binding SaveOriginalText}" IsEnabled="{Binding CanConfigureHistoryStorage}" Margin="0,0,20,0" />
                                <CheckBox x:Name="SaveOptimizedTextCheckBox" Content="保存优化稿" IsChecked="{Binding SaveOptimizedText}" IsEnabled="{Binding CanConfigureHistoryStorage}" />
                            </WrapPanel>
                            <TextBlock Text="最大记录数量（1–100）" Style="{StaticResource LabelText}" /><TextBox Text="{Binding PromptHistoryLimit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GlassPlainTextBox}" IsEnabled="{Binding CanConfigureHistoryStorage}"
                                                                                                  local:IntegerInputBehavior.Minimum="1" local:IntegerInputBehavior.Maximum="100"
                                                                                                                 ToolTip="请输入 1–100" Margin="0,6,0,0" />
                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="历史保留天数（1–3650 天）" Style="{StaticResource LabelText}" /><TextBox x:Name="HistoryRetentionDaysTextBox" Text="{Binding HistoryRetentionDays, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GlassPlainTextBox}" IsEnabled="{Binding CanConfigureHistoryStorage}"
                                                                                                                 local:IntegerInputBehavior.Minimum="1" local:IntegerInputBehavior.Maximum="3650" ToolTip="仅输入 1–3650 天" Margin="0,6,0,0" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="草稿自动保存间隔（250–10000 毫秒）" Style="{StaticResource LabelText}" /><TextBox x:Name="AutosaveDelayTextBox" Text="{Binding AutosaveDelayMilliseconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GlassPlainTextBox}"
                                                                                                                   local:IntegerInputBehavior.Minimum="250" local:IntegerInputBehavior.Maximum="10000" ToolTip="仅输入 250–10000 毫秒" Margin="0,6,0,0" /></StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=外观与窗口}">
                            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="外观与窗口" Style="{StaticResource SectionTitle}" /><TextBlock Text="统一调整界面外观、窗口行为与 Windows 集成，修改会即时预览。" Style="{StaticResource SettingsSupportingText}" Margin="0,4,0,0" /></StackPanel>
                            </Grid>
                            <TextBlock Text="外观" Foreground="{DynamicResource BrandBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ListBox x:Name="ThemeChoiceList" ItemsSource="{Binding ThemeModes}" SelectedValuePath="Value"
                                     SelectedValue="{Binding ThemeMode}" ItemContainerStyle="{StaticResource ThemeChoiceItem}"
                                     IsEnabled="{Binding IsDefaultSkinSelected}"
                                     Background="Transparent" BorderThickness="0" Padding="0">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
