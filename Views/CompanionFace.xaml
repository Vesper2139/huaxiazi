<UserControl x:Class="PromptFloat.Views.CompanionFace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="44" Height="44" Focusable="False"
             IsHitTestVisible="True" Cursor="SizeAll" SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Grid x:Name="GazeRoot" Width="44" Height="44" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <RotateTransform x:Name="GazeRotation" />
        </Grid.RenderTransform>
        <Grid x:Name="FaceRoot" Width="44" Height="44" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BodyScale" ScaleX="1" ScaleY="1" />
                    <RotateTransform x:Name="ExpressionRotation" />
                    <TranslateTransform x:Name="BodyOffset" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Ellipse Margin="1.5" Fill="{DynamicResource CompanionSurfaceBrush}"
                 Stroke="{DynamicResource CompanionBorderBrush}" StrokeThickness="1">
            <Ellipse.Effect>
                <DropShadowEffect Color="{DynamicResource CompanionShadowColor}"
                                  BlurRadius="8" ShadowDepth="2" Opacity="0.32" />
            </Ellipse.Effect>
            </Ellipse>

            <Grid x:Name="FaceLayer" RenderTransformOrigin="0.5,0.5">
            <Grid.Effect>
                <DropShadowEffect Color="{DynamicResource CompanionGlowColor}"
                                  BlurRadius="7" ShadowDepth="0" Opacity="0.85" />
            </Grid.Effect>
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BlinkScale" ScaleY="1" CenterX="22" CenterY="20" />
                    <TranslateTransform x:Name="GazeOffset" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Path x:Name="LeftEye" Stroke="{DynamicResource CompanionFaceBrush}" StrokeThickness="2.2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            <Path x:Name="RightEye" Stroke="{DynamicResource CompanionFaceBrush}" StrokeThickness="2.2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            <Path x:Name="Mouth" Stroke="{DynamicResource CompanionFaceBrush}" StrokeThickness="2.2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Grid>

            <Ellipse x:Name="ProgressRing" Margin="3.5" Stroke="{DynamicResource CompanionAccentBrush}"
                 StrokeThickness="1.4" StrokeDashArray="3,3" Opacity="0"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><RotateTransform x:Name="RingRotation" /></Ellipse.RenderTransform>
            </Ellipse>
            <Path x:Name="LeftSignal" Data="M4 16 L4 28 M7.5 18 L7.5 26" Stroke="{DynamicResource CompanionFaceBrush}"
              StrokeThickness="1.4" StrokeStartLineCap="Round" Opacity="0" />
            <Path x:Name="RightSignal" Data="M40 16 L40 28 M36.5 18 L36.5 26" Stroke="{DynamicResource CompanionFaceBrush}"
              StrokeThickness="1.4" StrokeStartLineCap="Round" Opacity="0" />
        </Grid>
    </Grid>
</UserControl>
