<UserControl x:Class="Huaxiazi.Views.CompanionFace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Huaxiazi.Views"
             Width="{DynamicResource SkinCompanionSize}" Height="{DynamicResource SkinCompanionSize}" Focusable="False"
             IsHitTestVisible="True" Cursor="SizeAll" SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Grid x:Name="GazeRoot" Width="{DynamicResource SkinCompanionSize}" Height="{DynamicResource SkinCompanionSize}" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="GazeRotation" />
                <TranslateTransform x:Name="OrbGazeOffset" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid x:Name="FaceRoot" Width="{DynamicResource SkinCompanionSize}" Height="{DynamicResource SkinCompanionSize}" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BodyScale" ScaleX="1" ScaleY="1" />
                    <RotateTransform x:Name="ExpressionRotation" />
                    <TranslateTransform x:Name="BodyOffset" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Ellipse x:Name="CompanionSurface" Margin="1.5" Fill="{DynamicResource CompanionSurfaceBrush}"
                 Stroke="{DynamicResource CompanionBorderBrush}" StrokeThickness="1">
            <Ellipse.Effect>
                <DropShadowEffect Color="{DynamicResource CompanionShadowColor}"
                                  BlurRadius="8" ShadowDepth="2" Opacity="0.32" />
            </Ellipse.Effect>
            </Ellipse>

            <Grid x:Name="FaceLayer" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="HeadScale" ScaleX="1" ScaleY="1" />
                    <RotateTransform x:Name="HeadRotation" />
                    <TranslateTransform x:Name="HeadOffset" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.Effect>
                <DropShadowEffect Color="{DynamicResource CompanionGlowColor}"
                                  BlurRadius="7" ShadowDepth="0" Opacity="0.85" />
            </Grid.Effect>
            <Grid x:Name="EyeLayer" RenderTransformOrigin="0.5,0.45">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="BlinkScale" ScaleY="1" CenterX="22" CenterY="20" />
                        <TranslateTransform x:Name="GazeOffset" />
                        <!-- Keep the eyes optically above the mouth even when gaze Y moves down. -->
                        <TranslateTransform x:Name="EyeVisualOffset" Y="-1.5" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Path x:Name="LeftEye" Stroke="{DynamicResource CompanionFaceBrush}" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <Path x:Name="RightEye" Stroke="{DynamicResource CompanionFaceBrush}" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Grid>
            <Path x:Name="Mouth" Stroke="{DynamicResource CompanionFaceBrush}" StrokeThickness="2.2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MouthScale" ScaleX="1" ScaleY="1" CenterX="22" CenterY="29" />
                        <RotateTransform x:Name="MouthRotation" CenterX="22" CenterY="29" />
                        <TranslateTransform x:Name="MouthPoseOffset" />
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>
            </Grid>

            <Ellipse x:Name="ProgressRing" Margin="3.5" Stroke="{DynamicResource CompanionAccentBrush}"
                 StrokeThickness="1.4" StrokeDashArray="3,3" Opacity="0"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><RotateTransform x:Name="RingRotation" /></Ellipse.RenderTransform>
            </Ellipse>
            <Path x:Name="LeftSignal" Data="M4 16 L4 28 M7.5 18 L7.5 26" Stroke="{DynamicResource CompanionFaceBrush}"
              StrokeThickness="1.4" StrokeStartLineCap="Round" Opacity="0" />
            <Path x:Name="RightSignal" Data="M40 16 L40 28 M36.5 18 L36.5 26" Stroke="{DynamicResource CompanionFaceBrush}"
              StrokeThickness="1.4" StrokeStartLineCap="Round" Opacity="0" />
            <Rectangle x:Name="SkinSpriteHost" Margin="-1" Visibility="Collapsed" IsHitTestVisible="False"
                       RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SkinSpriteScale"
                                        ScaleX="{DynamicResource SkinCompanionOverscan}"
                                        ScaleY="{DynamicResource SkinCompanionOverscan}" />
                        <!-- PNG 的透明画布中心不等于角色内容中心；用皮肤令牌校准视觉锚点。 -->
                        <TranslateTransform x:Name="SkinSpriteOffset"
                                             Y="{DynamicResource SkinCompanionOffsetY}" />
                        <TranslateTransform x:Name="SkinSpriteGaze" />
                        <ScaleTransform x:Name="SkinSpriteTransitionScale" ScaleX="1" ScaleY="1" />
                    </TransformGroup>
                </Rectangle.RenderTransform>
                <Rectangle.Fill>
                    <ImageBrush x:Name="SkinSpriteBrush" Stretch="UniformToFill" ViewboxUnits="RelativeToBoundingBox" />
                </Rectangle.Fill>
            </Rectangle>
            <local:VectorCompanionRenderer x:Name="VectorSpriteHost" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
