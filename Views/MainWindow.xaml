<Window x:Class="PromptFloat.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PromptFloat.Models"
        xmlns:local="clr-namespace:PromptFloat.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Vesper" Icon="pack://siteoforigin:,,,/Resources/Brand/Vesper.ico" Width="600" Height="210" MinWidth="420" MinHeight="152"
        WindowStyle="None" AllowsTransparency="False" Background="{StaticResource BgBrush}"
        ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed" ToolTipService.InitialShowDelay="250"
        Loaded="MainWindow_OnLoaded">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:CategoryToBoolConverter x:Key="CategoryToBool" />
        <local:DepthToBoolConverter x:Key="DepthToBool" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBoolConverter x:Key="InverseBool" />
        <local:ViewModeToBoolConverter x:Key="ViewModeToBool" />
        <local:CountZeroToVisibilityConverter x:Key="CountZeroToVisibility" />

        <Style x:Key="MiniSegmentedButton" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border x:Name="Indicator" Height="2" Width="18" CornerRadius="1" Margin="0,0,0,2"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                        Background="{StaticResource BrandBrush}" Opacity="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SelectedSurfaceBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource HoverSurfaceBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EdgeToolButton" TargetType="Button" BasedOn="{StaticResource ToolIconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
        </Style>
        <Style x:Key="CompactTitleButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
        </Style>
        <Style x:Key="TitleToggleButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SelectedSurfaceBrush}" /><Setter Property="Foreground" Value="{StaticResource BrandBrush}" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource HoverSurfaceBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactGenerateButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinWidth" Value="68" /><Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="11,0" /><Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="TitleModelSelector" TargetType="ComboBox" BasedOn="{StaticResource GlassComboBox}">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="MaxWidth" Value="180" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,0,24,0" />
        </Style>
        <Style x:Key="PopupCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PopupBrush}" /><Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="9" /><Setter Property="Padding" Value="8" />
        </Style>

        <ContextMenu x:Key="AppMainMenu" Style="{StaticResource AppContextMenu}"
                     DataContext="{Binding RelativeSource={RelativeSource Self}, Path=PlacementTarget.DataContext}">
            <MenuItem Header="重新生成" Style="{StaticResource AppMenuItem}" Command="{Binding RegenerateCommand}" />
            <MenuItem Header="复制优化稿" Style="{StaticResource AppMenuItem}" Command="{Binding CopyResultCommand}" />
            <MenuItem Header="粘贴" Style="{StaticResource AppMenuItem}" Command="{Binding PasteFromClipboardCommand}" />
            <MenuItem Header="清空" Style="{StaticResource AppMenuItem}" Command="{Binding ClearInputCommand}" />
            <MenuItem Header="撤销工作区操作" Style="{StaticResource AppMenuItem}" Command="{Binding UndoWorkspaceCommand}" />
            <MenuItem Header="恢复工作区操作" Style="{StaticResource AppMenuItem}" Command="{Binding RedoWorkspaceCommand}" />
            <MenuItem Header="编辑成稿" Style="{StaticResource AppMenuItem}" Command="{Binding BeginEditResultCommand}" />
            <MenuItem Header="保存归档" Style="{StaticResource AppMenuItem}" Command="{Binding SaveEditedResultCommand}" />
            <MenuItem Header="撤销归档" Style="{StaticResource AppMenuItem}" Command="{Binding UndoArchiveCommand}" />
            <Separator Style="{StaticResource AppMenuSeparator}" />
            <MenuItem Header="设置…" Style="{StaticResource AppMenuItem}" Click="SettingsMenu_OnClick" />
            <MenuItem Header="最小化到任务栏" Style="{StaticResource AppMenuItem}" Click="TaskbarMinimizeButton_OnClick" />
            <MenuItem Header="收起为悬浮球" Style="{StaticResource AppMenuItem}" Click="MinimizeMenu_OnClick" />
            <MenuItem Header="退出" Style="{StaticResource AppMenuItem}" Click="ExitMenu_OnClick" />
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Border x:Name="WindowSurface" Style="{StaticResource GlassPanel}" RenderTransformOrigin="0.05,0.12">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                    <TranslateTransform X="0" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid Margin="4,3,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="111" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" MinHeight="30" MouseLeftButtonDown="DragHandle_OnMouseLeftButtonDown">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="30" Background="Transparent" />
                        <StackPanel x:Name="VesperWordmark" Margin="5,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}" LineHeight="12">
                                <Run Text="VES" /><Run Text="PER" Foreground="{StaticResource BrandBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <ComboBox x:Name="ProviderSelector" Grid.Column="1" Style="{StaticResource TitleModelSelector}"
                              ItemsSource="{Binding ProviderProfiles}" DisplayMemberPath="Name"
                              SelectedItem="{Binding ActiveProviderProfile, Mode=TwoWay}"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,6,0"
                              ToolTip="当前模型；切换后下一次生成立即生效" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="PinButton" Style="{StaticResource TitleToggleButton}" Click="PinButton_OnClick" ToolTip="置顶">
                            <Path Style="{StaticResource CrispIconPath}" Data="{StaticResource IconPin}" />
                        </ToggleButton>
                        <Button x:Name="SettingsButton" Style="{StaticResource CompactTitleButton}" Click="SettingsMenu_OnClick" ToolTip="设置">
                            <Path Style="{StaticResource CrispIconPath}" Data="{StaticResource IconSettings}" />
                        </Button>
                        <Button x:Name="CollapseToBallButton" Style="{StaticResource CompactTitleButton}" Click="CollapseToBallButton_OnClick" ToolTip="收起为悬浮球">
                            <Path Width="16" Height="12" Stretch="Uniform" Fill="{StaticResource BrandBrush}" Data="{StaticResource IconBrandWings}" />
                        </Button>
                        <Button Style="{StaticResource CompactTitleButton}" Click="CloseButton_OnClick" ToolTip="关闭">
                            <Path Style="{StaticResource CrispIconPath}" Data="{StaticResource IconClose}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource EditorSurface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="20" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox x:Name="MainTextBox" Grid.Row="0" Style="{StaticResource VesperTextEditor}" Padding="14,12,14,10" FontSize="{DynamicResource EditorFontSize}" Tag="{Binding EditorPlaceholderText}"
                                 Visibility="{Binding ShowDiff, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                                 Text="{Binding DisplayText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                                 AcceptsReturn="True" AutomationProperties.Name="正文输入或生成结果" />
                        <ScrollViewer Grid.Row="0" Style="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding ShowDiff, Converter={StaticResource BoolToVisibility}}" Padding="14,10">
                            <TextBlock x:Name="DiffOverlay" TextWrapping="Wrap" Foreground="{StaticResource BodyTextBrush}" FontSize="13" />
                        </ScrollViewer>

                        <Border x:Name="FeedbackOverlay" Grid.Row="0" Panel.ZIndex="20"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,8,10,0"
                                MaxWidth="360" Padding="9,5" IsHitTestVisible="False"
                                CornerRadius="{DynamicResource SmallRadius}" Background="{StaticResource PopupBrush}"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                                Visibility="{Binding HasOperationalNotice, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.LiveSetting="Polite">
                            <DockPanel LastChildFill="True">
                                <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                                         Fill="{StaticResource BrandBrush}" />
                                <TextBlock Text="{Binding OperationalNotice}" Foreground="{StaticResource BodyTextBrush}"
                                           FontSize="11" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="0" Panel.ZIndex="20" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Width="420" MaxWidth="420" Margin="12,12,12,10" Padding="10"
                                CornerRadius="{DynamicResource SmallRadius}" Background="{StaticResource PopupBrush}"
                                BorderBrush="{StaticResource BrandBrush}" BorderThickness="1"
                                Visibility="{Binding HasClarification, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding OperationalNotice}" Foreground="{StaticResource BodyTextBrush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="2,0,2,7" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="ClarificationAnswerBox" Text="{Binding ClarificationAnswer, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource GlassPlainTextBox}" MinHeight="32" Padding="9,6"
                                             AutomationProperties.Name="澄清问题的补充回答" />
                                    <Button Grid.Column="1" Content="继续" Command="{Binding SubmitClarificationCommand}"
                                            Style="{StaticResource CompactGenerateButton}" Margin="8,0,0,0"
                                            ToolTip="提交补充信息并继续生成" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="EditorDockBottom" Grid.Row="1" MinHeight="32" Background="{StaticResource DockBrush}"
                                 BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="4,2">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton Style="{StaticResource MiniSegmentedButton}" Content="润色"
                                                  Visibility="{Binding ShowModeSwitcher, Converter={StaticResource BoolToVisibility}}"
                                                  IsChecked="{Binding IsPolishMode, Mode=OneWay}" Command="{Binding SelectModeCommand}"
                                                  CommandParameter="{x:Static models:ApplicationMode.Polish}" />
                                    <ToggleButton Style="{StaticResource MiniSegmentedButton}" Content="提示词"
                                                  Visibility="{Binding ShowModeSwitcher, Converter={StaticResource BoolToVisibility}}"
                                                  IsChecked="{Binding IsPolishMode, Converter={StaticResource InverseBool}, Mode=OneWay}"
                                                  Command="{Binding SelectModeCommand}" CommandParameter="{x:Static models:ApplicationMode.PromptOptimize}" />
                                    <Button Style="{StaticResource EdgeToolButton}" Command="{Binding PasteFromClipboardCommand}" ToolTip="从剪贴板粘贴">
                                        <Path Style="{StaticResource CrispIconPath}" Data="{StaticResource IconPaste}" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button x:Name="HistoryButton" Style="{StaticResource EdgeToolButton}" Click="HistoryButton_OnClick" ToolTip="历史">
                                        <Path Style="{StaticResource CrispIconPath}" Data="{StaticResource IconHistory}" />
                                    </Button>
                                    <ToggleButton Style="{StaticResource MiniSegmentedButton}" Content="原文"
                                                  IsChecked="{Binding ViewMode, Converter={StaticResource ViewModeToBool}, ConverterParameter={x:Static models:ViewMode.Original}, Mode=OneWay}"
                                                  Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:ViewMode.Original}" />
                                    <ToggleButton Style="{StaticResource MiniSegmentedButton}" Content="优化稿"
                                                  IsChecked="{Binding ViewMode, Converter={StaticResource ViewModeToBool}, ConverterParameter={x:Static models:ViewMode.Optimized}, Mode=OneWay}"
                                                  Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:ViewMode.Optimized}" IsEnabled="{Binding ShowResultToggle}" />
                                    <ToggleButton x:Name="DiffToggleButton" Style="{StaticResource MiniSegmentedButton}" Content="DIFF"
                                                  IsChecked="{Binding ShowDiff, Mode=TwoWay}" IsEnabled="{Binding ShowResultToggle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource EdgeToolButton}" Command="{Binding UndoWorkspaceCommand}" IsEnabled="{Binding CanUndoWorkspace}" ToolTip="撤销工作区操作">
                                        <Path Style="{StaticResource CrispIconPath}" Data="{StaticResource IconUndo}" />
                                    </Button>
                                    <Button Style="{StaticResource EdgeToolButton}" Command="{Binding RedoWorkspaceCommand}" IsEnabled="{Binding CanRedoWorkspace}" ToolTip="恢复工作区操作">
                                        <Path Style="{StaticResource CrispIconPath}" Data="{StaticResource IconRedo}" />
                                    </Button>
                                    <Button Style="{StaticResource EdgeToolButton}" Click="MenuButton_OnClick" ContextMenu="{StaticResource AppMainMenu}" ToolTip="更多">
                                        <Path Style="{StaticResource CrispIconPath}" Data="{StaticResource IconMore}" />
                                    </Button>
                                    <Button x:Name="EditorPrimaryAction" Style="{StaticResource CompactGenerateButton}"
                                            Command="{Binding OptimizeCommand}"
                                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="11" Height="11" Margin="0,0,5,0" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                  Data="{StaticResource IconBrandSpark}" />
                                            <TextBlock Text="{Binding PrimaryActionText}" FontSize="12" FontWeight="Medium" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="StopGenerationButton" Style="{StaticResource CompactGenerateButton}"
                                            Command="{Binding CancelCommand}" Content="停止"
                                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 精灵与面板分层：展开/收起时精灵保持自身尺寸，便笺从其后方铺开。 -->
        <Border x:Name="CompanionDragHandle" Panel.ZIndex="30" Width="34" Height="34" Margin="4,1,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                Cursor="SizeAll" ToolTip="按住精灵拖动窗口；单击与精灵互动"
                MouseLeftButtonDown="CompanionDragHandle_OnMouseLeftButtonDown">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CompanionTransitionOffset" X="0" Y="0" />
            </Border.RenderTransform>
            <Viewbox Width="34" Height="34" Stretch="Uniform">
                <local:CompanionFace x:Name="CompanionHost" State="{Binding CompanionState}" />
            </Viewbox>
        </Border>

        <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=HistoryButton}" Placement="Top" AllowsTransparency="True" StaysOpen="False">
            <Border Style="{StaticResource PopupCard}" Width="300" MaxHeight="240">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="最近记录" Style="{StaticResource LabelText}" Margin="8,2,8,6" />
                    <ScrollViewer Grid.Row="1" Style="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto" MaxHeight="180">
                        <ItemsControl ItemsSource="{Binding RecentRevisions}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Style="{StaticResource GlassButton}" HorizontalContentAlignment="Left" Padding="10,5" Margin="0,2"
                                        Click="HistoryItem_OnClick" Tag="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Topic}" FontSize="12" Foreground="{StaticResource BodyTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                        <TextBlock Text="{Binding OriginalText}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
        <ResizeGrip Width="14" Height="14" Margin="0,0,3,3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.35" />
    </Grid>
</Window>
