<UserControl x:Class="Huaxiazi.Views.ProviderProfileListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Huaxiazi.Views"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <local:CountZeroToVisibilityConverter x:Key="CountZeroToVisibility" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:ProviderPlatformDisplayNameConverter x:Key="ProviderPlatformDisplayName" />
        <local:ProfileApiKeyStatusConverter x:Key="ProfileApiKeyStatus" />
        <local:ProviderActiveVisibilityConverter x:Key="ProviderActiveVisibility" />
        <local:ProviderInactiveVisibilityConverter x:Key="ProviderInactiveVisibility" />
        <local:ProviderActiveEnabledConverter x:Key="ProviderActiveEnabled" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="配置管理" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="选择配置即可编辑、测试或设为当前。" Style="{StaticResource LabelText}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding ConnectionStatus}" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionStatusKind}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionStatusKind}" Value="Failure"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionStatusKind}" Value="Pending"><Setter Property="Foreground" Value="{DynamicResource BrandBrush}" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11">
                    <Run Text="{Binding ProviderProfiles.Count, Mode=OneWay}" /><Run Text=" 个配置" />
                </TextBlock>
            </Border>
        </Grid>

        <!-- 搜索与配置操作统一放在列表页工具栏。 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource GlassPlainTextBox}"
                     Text="{Binding ProviderListSearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="搜索配置名称或厂商…" VerticalContentAlignment="Center" Height="36" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Style="{StaticResource GlassButton}" Content="复制" Command="{Binding DuplicateProviderCommand}"
                        IsEnabled="{Binding CanDuplicateOrEditProvider}" Padding="11,5" ToolTip="复制所选配置" />
                <Button Style="{StaticResource GlassButton}" Content="编辑" Command="{Binding NavigateToProviderEditCommand}"
                        CommandParameter="{Binding SelectedProviderProfile}" IsEnabled="{Binding CanDuplicateOrEditProvider}"
                        Padding="11,5" Margin="6,0,0,0" />
                <Button Style="{StaticResource GlassButton}" Content="删除" Click="DeleteSelectedProfile_OnClick"
                        IsEnabled="{Binding CanRemoveProvider}" Foreground="{DynamicResource DangerBrush}"
                        Padding="11,5" Margin="6,0,0,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="添加模型" Command="{Binding AddProviderCommand}"
                        Margin="6,0,0,0" Padding="13,5" />
            </StackPanel>
        </Grid>

        <!-- 配置列表 -->
        <Border Grid.Row="2" Style="{StaticResource SettingsCard}" Padding="12">
            <Grid>
                <ListBox x:Name="ProfileListBox"
                         ItemsSource="{Binding FilteredProviderProfiles}"
                         SelectedItem="{Binding SelectedProviderProfile, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ProviderProfileCardItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         local:NestedScrollBehavior.ForwardMouseWheelToParent="True"
                         MouseDoubleClick="ProfileListBox_OnMouseDoubleClick"
                         KeyDown="ProfileListBox_OnKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BodyTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Platform, Converter={StaticResource ProviderPlatformDisplayName}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Model}" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                           Margin="12,0" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                <Border Grid.Column="2" Style="{StaticResource ProviderStatusDot}">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource ProfileApiKeyStatus}">
                                            <Binding />
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                        </MultiBinding>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button Content="测试" Style="{StaticResource GlassButton}" Padding="10,4" MinWidth="58" HorizontalContentAlignment="Center" FontSize="11"
                                            Command="{Binding DataContext.TestProviderProfileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" ToolTip="可选：测试当前配置的连接" />
                                    <Button Content="当前使用" Style="{StaticResource GlassButton}" Padding="10,4" MinWidth="78" HorizontalContentAlignment="Center" FontSize="11" Margin="6,0,0,0"
                                            IsEnabled="False">
                                        <Button.Visibility>
                                            <MultiBinding Converter="{StaticResource ProviderActiveVisibility}">
                                                <Binding />
                                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                            </MultiBinding>
                                        </Button.Visibility>
                                    </Button>
                                    <Button Content="设为当前" Style="{StaticResource GlassButton}" Padding="10,4" MinWidth="78" HorizontalContentAlignment="Center" FontSize="11" Margin="6,0,0,0"
                                            Command="{Binding DataContext.SetActiveProviderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Button.Visibility>
                                            <MultiBinding Converter="{StaticResource ProviderInactiveVisibility}">
                                                <Binding />
                                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                            </MultiBinding>
                                        </Button.Visibility>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空状态 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding FilteredProviderProfiles.Count, Converter={StaticResource CountZeroToVisibility}}">
                    <Path Style="{StaticResource CrispIconPath}" Data="{StaticResource IconModel}" Width="48" Height="48"
                          Stroke="{DynamicResource MutedBrush}" Opacity="0.6" />
                    <TextBlock Text="还没有模型配置" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource BodyTextBrush}" HorizontalAlignment="Center" Margin="0,14,0,4" />
                    <TextBlock Text="添加第一个模型以开始使用" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,14" />
                    <Button Style="{StaticResource PrimaryButton}" Content="添加你的第一个模型"
                            Command="{Binding AddProviderCommand}" Padding="16,8" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
