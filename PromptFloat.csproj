<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net8.0-windows is required for WPF + Windows-specific APIs (Clipboard, low-level keyboard hook) -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>Huaxiazi</AssemblyName>
    <RootNamespace>PromptFloat</RootNamespace>
    <Product>Vesper</Product>
    <Title>Vesper</Title>
    <AssemblyTitle>Vesper</AssemblyTitle>
    <Description>表达润色与提示词优化桌面工具</Description>
    <Company>Huaxiazi</Company>
    <Authors>Huaxiazi</Authors>
    <Copyright>Copyright © Huaxiazi</Copyright>
    <LangVersion>latest</LangVersion>
    <!-- 显式版本号：作为自动更新检查（UpdateChecker）比较的“当前版本”权威来源 -->
    <Version>1.5.0</Version>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Brand\Vesper.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Public release packages must not contain portable PDBs, which are not
       required at runtime and may expose local source-document paths. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- 排除嵌套的测试工程：SDK 默认的 **\*.cs 规则会把 PromptFloat.Tests 下的
       测试文件也纳入主工程编译，而主工程未引用 xunit，会导致 CS0246 并拖垮发布。 -->
  <ItemGroup>
    <Compile Remove="tools\**" />
    <Compile Remove="PromptFloat.Tests\**\*.cs" />
    <EmbeddedResource Remove="PromptFloat.Tests\**" />
    <None Remove="PromptFloat.Tests\**" />
    <Page Remove="PromptFloat.Tests\**" />
    <ApplicationDefinition Remove="PromptFloat.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Skins\LuoXiaoHei\*.png" Exclude="Resources\Skins\LuoXiaoHei\sprites*.png" />
    <Resource Include="Resources\Skins\MaoDie\*.png" Exclude="Resources\Skins\MaoDie\sprites*.png" />
    <Resource Include="Resources\Skins\MaoDie\Provided\*.png" />
    <Content Include="Resources\Skins\LuoXiaoHei\vector.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Brand\Vesper.ico" />
    <None Remove="Resources\Brand\Vesper-256.png" />
    <Content Include="Resources\Brand\Vesper.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\Brand\Vesper-256.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>


  <ItemGroup>
    <!-- MVVM source generators ([ObservableProperty], [RelayCommand]) -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.21" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Prompt template files are read at runtime from the output directory -->
    <None Update="Prompts\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Config\default-config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Agent Skills remain external prompt packages. They are shipped under
         Presets/Skills and imported into the user's managed catalog at runtime. -->
    <None Update="Skills\**\*" Link="Presets\%(RecursiveDir)%(Filename)%(Extension)" TargetPath="Presets\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- 额外把 default-config.json 拷贝到输出根目录，
       以便单元测试（PromptFloat.Tests）能从 AppContext.BaseDirectory 读取它做一致性校验。 -->
  <Target Name="CopyDefaultConfigToOutputRoot" AfterTargets="AfterBuild;AfterPublish">
    <Copy SourceFiles="Config\default-config.json"
          DestinationFiles="$(OutDir)default-config.json"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
